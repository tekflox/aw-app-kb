{
  "manifest_version": 1,
  "id": "kb",
  "name": "Knowledge Base",
  "version": "0.30.0",
  "description": "Semantic search over project docs and skills, backed by Postgres/pgvector. Ported from the agentic-workspace monolith's Knowledge Base \u2014 file browser/editor, semantic + text search, code-map build jobs, and an MCP surface (search/update/delete_knowledge_base, search/load_skill) that aw-mcp-gateway picks up automatically.",
  "icon": "book-open",
  "tier": "container",
  "category": "Services",
  "publisher": "TekFlox",
  "resource_estimate": {
    "cpu": "medium",
    "memory": "~1.5 GB",
    "disk": "~2 GB"
  },
  "runtime": {
    "image": "ghcr.io/tekflox/aw-app-kb:latest",
    "port": 8000,
    "resources": {
      "cpus": 1,
      "mem_mb": 2048
    },
    "env": {
      "KB_DATA_DIR": "/app/persist/data",
      "KB_DIR_OVERRIDE": "/app/kb_output",
      "SHARED_REPOS_DIR": "/workspace-repos",
      "MAPPED_FOLDERS_DIR": "/workspace-folders",
      "PGDATA": "/app/persist/pgdata",
      "KB_SKILLS_DIR": "/app/skills",
      "KB_EXEC_SECRET": "${config.exec_secret}",
      "KB_EXEC_RETENTION_DAYS": "${config.exec_retention_days}",
      "KB_EXEC_MAX_ROWS": "${config.exec_max_rows}"
    },
    "volumes": [
      {
        "source": "$AW_APP_DATA",
        "target": "/app/persist",
        "mode": "rw"
      },
      {
        "source": "$AW_KB_DIR",
        "target": "/app/kb_output",
        "mode": "rw"
      },
      {
        "source": "$AW_WORKSPACE_REPOS",
        "target": "/workspace-repos",
        "mode": "ro"
      },
      {
        "source": "$AW_WORKSPACE_FOLDERS",
        "target": "/workspace-folders",
        "mode": "ro"
      },
      {
        "source": "$AW_WORKSPACE_SKILLS",
        "target": "/app/skills",
        "mode": "ro"
      },
      {
        "source": ".",
        "target": "/app/pkg",
        "mode": "rw"
      }
    ]
  },
  "permissions": [
    "containers:manage",
    "fs:workspace-data",
    "fs:workspace-read"
  ],
  "contributes": {
    "nav": [
      {
        "id": "kb.nav",
        "label": "Knowledge Base",
        "icon": "book-open",
        "section": "workspace",
        "opens": "kb.main"
      }
    ],
    "windows": [
      {
        "id": "kb.main",
        "title": "Knowledge Base",
        "icon": "book-open",
        "body": {
          "type": "managed_app",
          "kind": "web",
          "path": "/"
        }
      }
    ],
    "mcp": {
      "reload_on_save": true,
      "provides": [
        "search_knowledge_base",
        "update_knowledge_base",
        "delete_knowledge_base",
        "search_skills",
        "search_execution_history",
        "load_skill"
      ]
    },
    "skills": [
      {
        "id": "aw-kb-curator",
        "path": "skills/aw-kb-curator/SKILL.md"
      }
    ]
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "auto_start": {
        "type": "boolean",
        "default": true,
        "title": "Auto-start",
        "description": "Start the Knowledge Base container when the workspace starts."
      },
      "exec_secret": {
        "type": "string",
        "default": "",
        "title": "Execution-history write secret",
        "description": "Shared secret the agents-platform-runners app must send as X-KB-Exec-Secret to POST /api/kb/executions. Empty means the endpoint is closed (503) \u2014 it is never left open."
      },
      "exec_retention_days": {
        "type": "integer",
        "default": 30,
        "title": "Execution history retention (days)",
        "description": "How long an indexed run dump stays searchable via search_execution_history. AP-MT itself never purges runs, so this only affects findability, not the underlying record."
      },
      "exec_max_rows": {
        "type": "integer",
        "default": 80000,
        "title": "Execution history row cap",
        "description": "Global backstop on indexed execution chunks, independent of retention_days \u2014 oldest rows are pruned first once this is exceeded."
      }
    },
    "required": []
  },
  "dependencies": {},
  "migrations": {}
}
